# Sports Scout — Environment Variables
# Copy this file to .env and fill in your keys
# Load it before running: source .env && python3 scout.py

# The Odds API (https://the-odds-api.com) — free tier: 500 req/month
# Required for DraftKings lines. Without it, scout runs on ESPN stats only.
ODDS_API_KEY=your_key_here

# ESPN Fantasy Football — required for private leagues (e.g. "Philly Fantasy").
# Get these from your browser while logged into fantasy.espn.com:
#   DevTools -> Application (Chrome) or Storage (Firefox) -> Cookies
#   -> https://fantasy.espn.com -> copy the "espn_s2" and "SWID" values.
# Never commit real values here — this file is a template only.
ESPN_S2=your_espn_s2_cookie_value
ESPN_SWID={your-swid-cookie-value}

# Optional — defaults to the "Philly Fantasy" league if unset.
FANTASY_LEAGUE_ID=5814407
